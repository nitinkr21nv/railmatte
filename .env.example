# ==============================================================================
# RAILMATTE ROOT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in backend/ or root for backend execution.
# Front-end specific variables reside in frontend/.env.example

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Supabase Database (Optional for in-memory mock mode, Mandatory for cloud DB) ---
# Project settings -> API -> Project URL & Service Role key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Monad Blockchain Network (Testnet) ---
# Default RPC: https://testnet-rpc.monad.xyz
# Chain ID: 10143 (0x279f)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# --- Optional AI Assistance (Gemini API) ---
# Used strictly on backend for journey assistance drafting / issue categorization
# Never exposed to client. Product works fully without this key.
GEMINI_API_KEY=
